{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Debug",
      "description": "Default local development build without external EDA-tool tests.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SPICEUNION_BUILD_TESTS": "ON",
        "SPICEUNION_ENABLE_EXTERNAL_TESTS": "OFF"
      }
    },
    {
      "name": "external",
      "displayName": "External Spectre Debug",
      "description": "Debug build with external Spectre tests enabled.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake-build-external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SPICEUNION_BUILD_TESTS": "ON",
        "SPICEUNION_ENABLE_EXTERNAL_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "external",
      "configurePreset": "external"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "external",
      "configurePreset": "external",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
